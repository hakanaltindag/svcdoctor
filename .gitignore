# The kubeconfig `make kubernetes-up` generates for the kind validation cluster.
# It carries that throwaway cluster's client certificate and key, so it is never
# a tracked artefact — the cluster is created and destroyed by the same gate.
test/integration/kubernetes/env/kubeconfig.generated
